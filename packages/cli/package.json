{
  "version": "0.14.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lingyan000/fluxdo-plugin-tools.git",
    "directory": "packages/cli"
  },
  "name": "@fluxdo/plugin-cli",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "vendor",
    "localization"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsdown && node tools/build-runner.mjs"
  },
  "bin": {
    "fluxdo": "dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/project.d.mts",
      "import": "./dist/project.mjs"
    },
    "./dev": {
      "types": "./dist/dev/server.d.mts",
      "import": "./dist/dev/server.mjs"
    },
    "./runner": "./dist/dev/runner.js",
    "./localization": {
      "types": "./localization/compiler.d.mts",
      "import": "./localization/compiler.mjs"
    }
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "ajv": "8.20.0",
    "core-js-pure": "3.51.0",
    "fast-text-encoding": "1.0.6",
    "selfsigned": "5.5.0",
    "semver": "7.8.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "ws": "8.23.0",
    "acorn": "8.19.0",
    "opencc-js": "1.4.2"
  },
  "devDependencies": {
    "@fluxdo/plugin-sdk": "workspace:*",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

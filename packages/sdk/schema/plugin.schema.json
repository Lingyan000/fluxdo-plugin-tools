{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Lingyan000/fluxdo-plugin-tools/plugin.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "schema": {
      "enum": [
        9,
        10,
        11,
        12
      ]
    },
    "tasks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "apiVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "homepage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^https://"
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "ui": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:?#\\\\%])[a-zA-Z0-9_.\\-/]+$"
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:?#\\\\%])[a-zA-Z0-9_.\\-/]+$"
    },
    "webLogin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^https://"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:\\*\\.)?(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "background": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "publicImages": {
          "type": "boolean"
        },
        "connect": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https://"
          },
          "uniqueItems": true
        },
        "payments": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "enum": [
              "linuxDoCredit"
            ]
          },
          "uniqueItems": true
        },
        "credentials": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "header": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
              },
              "scheme": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_-]*$"
              },
              "requests": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "origin": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^https://"
                    },
                    "pathPrefix": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^/(?:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*)?$"
                    },
                    "methods": {
                      "type": "array",
                      "maxItems": 7,
                      "items": {
                        "enum": [
                          "GET",
                          "HEAD",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE",
                          "OPTIONS"
                        ]
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "origin",
                    "methods"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "requests"
            ],
            "additionalProperties": false
          }
        },
        "forum": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "profiles",
              "activity",
              "following"
            ]
          }
        }
      },
      "required": [
        "network"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "widget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "widget"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "widget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "presentation": {
            "enum": [
              "page",
              "modal"
            ]
          },
          "scroll": {
            "type": "boolean"
          },
          "navigation": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "icon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          "appBar": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "actions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "widget",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:\\*\\.)?(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "page": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        },
        "required": [
          "host",
          "path",
          "page"
        ],
        "additionalProperties": false
      }
    },
    "requiredFeatures": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "enum": [
          "browserModes",
          "automaticPagination",
          "gridLayouts",
          "virtualGrid",
          "confirmationDialog",
          "nativeExecutionLimits",
          "navigationEntries",
          "forumRead",
          "scheduledTasks",
          "localNotifications",
          "navigationBadge",
          "atomicStorage",
          "runtimePermissions",
          "adaptiveCollections",
          "modalDismiss",
          "cardNavigation",
          "contentPresentation",
          "eventStreams",
          "dataMigrations",
          "hostEnvironment",
          "pluginPreferences",
          "pageChrome"
        ]
      },
      "uniqueItems": true
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "preferences": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "toggle",
              "text",
              "choice"
            ]
          },
          "default": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "options": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": "string",
              "maxLength": 80
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "apiVersion",
    "id",
    "name",
    "version",
    "author",
    "ui",
    "script",
    "permissions"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "card"
      ]
    },
    {
      "required": [
        "pages"
      ],
      "properties": {
        "pages": {
          "minItems": 1
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "requiredFeatures"
        ],
        "properties": {
          "requiredFeatures": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "schema": {
            "enum": [
              10,
              11,
              12
            ]
          }
        }
      }
    }
  ]
}
